{
  "name": "opencode_mosp",
  "version": "1.2.23",
  "private": true,
  "description": "OpenCode model pricing and benchmark overview",
  "author": "GRASTROY Creations, Korcakov Roman",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GRASTROY-Creations/opencode_mosp.git"
  },
  "bugs": "https://github.com/react/react/issues",
  "engines": {
    "bun": ">=1.4.4"
  },
  "type": "module",
  "files": [
    "src",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "validate:mappings": "bun scripts/validate-mappings.ts",
    "generate:mappings": "bun scripts/generate-mappings.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "pack:plugin": "bun pm pack --destination ./dist",
    "version:update": "bun scripts/update-version.ts"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.0"
  },
  "peerDependencies": {
    "@opencode/theme": "2.2.0",
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opencode/theme": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/bun": "1.4.4",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "solid-js": "1.9.17",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
