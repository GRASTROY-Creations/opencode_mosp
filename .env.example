# Copy to .env for local experiments, or mirror into .envrc for direnv.
# Placeholder values only — never commit real credentials.

PLUGIN_NAME=opencode_model_overview
PLUGIN_VERSION=0.1.0
PLUGIN_OWNER=GRASTROY Creations

OPENCODE_MODEL_CACHE_TTL_SECONDS=3600
OPENCODE_BENCHMARK_CACHE_TTL_SECONDS=21600
OPENCODE_REQUEST_TIMEOUT_MS=10000

# Optional cache directory override; defaults to $XDG_CACHE_HOME/opencode-model-overview
# OPENCODE_MODEL_OVERVIEW_CACHE_DIR=

# Optional credentials (leave commented unless required by a verified source):
# HUGGINGFACE_TOKEN=
# OPENCODE_INFERENCE_API_KEY=
